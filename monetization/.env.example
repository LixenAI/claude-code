# ── Stripe ────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Get from Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Create products + prices in Stripe Dashboard, then paste the price IDs here
# Dashboard → Products → + Add product → Add a price (recurring)
STRIPE_SMART_MONTHLY=price_...
STRIPE_SMART_ANNUAL=price_...
STRIPE_PRO_MONTHLY=price_...
STRIPE_PRO_ANNUAL=price_...

# ── App ───────────────────────────────────────────────────────────────────
# Base URL of your app — used for Checkout redirect URLs
APP_BASE_URL=https://app.lixen.ai

# Port for the Stripe webhook server (default: 8001)
BILLING_WEBHOOK_PORT=8001

# ── GoHighLevel ───────────────────────────────────────────────────────────
# Get from GHL Settings → Integrations → API Keys
GHL_API_KEY=
GHL_LOCATION_ID=
