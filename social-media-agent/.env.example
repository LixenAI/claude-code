# ── REQUIRED — get from console.anthropic.com ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Database (default: sqlite file in ./data) ─────────────────────────────────
# DATABASE_URL=sqlite:///data/app.db

# ── Public URL of this server (needed for Instagram native publishing:
#    Meta fetches rendered videos from {PUBLIC_BASE_URL}/media/...) ───────────
# PUBLIC_BASE_URL=https://your-server.com

# ── Instagram native publishing (Meta Graph API) ──────────────────────────────
# Requires an Instagram Professional account linked to a Facebook Page,
# and a Meta app with instagram_content_publish permission.
# IG_ACCESS_TOKEN=EAAG...
# IG_USER_ID=17841400000000000

# ── TikTok native publishing (Content Posting API) ────────────────────────────
# From developers.tiktok.com. Unaudited apps upload to the account's inbox
# (video appears as a draft in the TikTok app to confirm). Once audited,
# set TIKTOK_DIRECT_POST=1 to publish directly.
# TIKTOK_ACCESS_TOKEN=act....
# TIKTOK_DIRECT_POST=0

# ── Voiceover (edge-tts voice for rendered short videos) ──────────────────────
# RENNEWME_TTS_VOICE=en-US-AndrewNeural

# ── Safety: log publishes instead of hitting platform APIs ────────────────────
# PUBLISH_DRY_RUN=1

# ── Legacy GoHighLevel integration (Lixen.AI brand + /ghl/* webhooks) ─────────
GHL_API_KEY=pit-...
GHL_LOCATION_ID=...
GHL_USER_ID=...
GHL_FB_ACCOUNT_ID=
GHL_IG_ACCOUNT_ID=
GHL_TIKTOK_ACCOUNT_ID=

# ── Webhook server ────────────────────────────────────────────────────────────
WEBHOOK_PORT=8000
WEBHOOK_SECRET=change-me
WEBHOOK_BASE_URL=https://your-server.com

# ── Optional — Canva REST API (legacy design re-export) ───────────────────────
# CANVA_API_TOKEN=your_canva_token_here
