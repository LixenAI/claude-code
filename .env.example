# ── GoHighLevel ──────────────────────────────────────────────────────────────
# Settings → Integrations → API Keys
GHL_API_KEY=your_ghl_api_key_here

# Visible in your GHL dashboard URL: /location/THIS_PART/dashboard
GHL_LOCATION_ID=your_location_id_here

# ── Google Places API ─────────────────────────────────────────────────────────
# console.cloud.google.com → Enable "Places API" → Create API Key (free tier)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ── Hunter.io ─────────────────────────────────────────────────────────────────
# hunter.io → Sign up free → Dashboard → API Key (25 free searches/month)
HUNTER_API_KEY=your_hunter_api_key_here

# ── Target Location ───────────────────────────────────────────────────────────
# City and state to search for leads (e.g. "Miami, FL" or "Austin, TX")
TARGET_CITY=Miami, FL
